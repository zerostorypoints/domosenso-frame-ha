{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Private compiled timer commands (not grants)",
  "type": "object",
  "properties": {
    "schema": {
      "const": 1
    },
    "component": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32,
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        },
        "commit": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40,
          "pattern": "^[0-9a-f]{7,40}$"
        },
        "dev": {
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "version",
        "commit",
        "dev"
      ],
      "additionalProperties": false
    },
    "definitions": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "Closed timer command definitions (not grants)",
      "type": "object",
      "properties": {
        "actions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "enum": [
                  "timers.start",
                  "timers.pause",
                  "timers.resume",
                  "timers.cancel"
                ]
              },
              "revision": {
                "const": 1
              },
              "title_key": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120,
                "pattern": "^meta\\.assistant\\.[a-z0-9_.]+$"
              },
              "description_key": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120,
                "pattern": "^meta\\.assistant\\.[a-z0-9_.]+$"
              },
              "examples_key": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120,
                "pattern": "^meta\\.assistant\\.[a-z0-9_.]+$"
              },
              "operation": {
                "const": "timer"
              },
              "action_type": {
                "const": "timer-action.v1"
              },
              "result_type": {
                "const": "timer-result.v1"
              },
              "parameters": {
                "type": "object",
                "properties": {
                  "durationSeconds": {
                    "type": "object",
                    "properties": {
                      "type": {
                        "const": "integer"
                      },
                      "minimum": {
                        "const": 1
                      },
                      "maximum": {
                        "const": 86400
                      }
                    },
                    "required": [
                      "type",
                      "minimum",
                      "maximum"
                    ],
                    "additionalProperties": false
                  },
                  "confirmReplace": {
                    "type": "object",
                    "properties": {
                      "type": {
                        "const": "boolean"
                      }
                    },
                    "required": [
                      "type"
                    ],
                    "additionalProperties": false
                  }
                },
                "additionalProperties": false
              },
              "confirmation": {
                "enum": [
                  "replace_active",
                  "none"
                ]
              },
              "effect": {
                "enum": [
                  "start",
                  "pause",
                  "resume",
                  "cancel"
                ]
              }
            },
            "required": [
              "id",
              "revision",
              "title_key",
              "description_key",
              "examples_key",
              "operation",
              "action_type",
              "result_type",
              "parameters",
              "confirmation",
              "effect"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "actions"
      ],
      "additionalProperties": false
    },
    "translations": {
      "type": "object",
      "properties": {
        "en": {
          "type": "object",
          "properties": {
            "meta": {
              "type": "object",
              "properties": {
                "assistant": {
                  "type": "object",
                  "propertyNames": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 80,
                    "pattern": "^[a-z][a-z0-9_-]*$"
                  },
                  "additionalProperties": {
                    "type": "object",
                    "properties": {
                      "title": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 120
                      },
                      "description": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 300
                      },
                      "examples": {
                        "type": "array",
                        "items": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 300
                        },
                        "minItems": 1,
                        "maxItems": 3
                      }
                    },
                    "required": [
                      "title",
                      "description",
                      "examples"
                    ],
                    "additionalProperties": false
                  },
                  "maxProperties": 64
                }
              },
              "required": [
                "assistant"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "meta"
          ],
          "additionalProperties": false
        },
        "de": {
          "type": "object",
          "properties": {
            "meta": {
              "type": "object",
              "properties": {
                "assistant": {
                  "type": "object",
                  "propertyNames": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 80,
                    "pattern": "^[a-z][a-z0-9_-]*$"
                  },
                  "additionalProperties": {
                    "type": "object",
                    "properties": {
                      "title": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 120
                      },
                      "description": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 300
                      },
                      "examples": {
                        "type": "array",
                        "items": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 300
                        },
                        "minItems": 1,
                        "maxItems": 3
                      }
                    },
                    "required": [
                      "title",
                      "description",
                      "examples"
                    ],
                    "additionalProperties": false
                  },
                  "maxProperties": 64
                }
              },
              "required": [
                "assistant"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "meta"
          ],
          "additionalProperties": false
        },
        "pl": {
          "type": "object",
          "properties": {
            "meta": {
              "type": "object",
              "properties": {
                "assistant": {
                  "type": "object",
                  "propertyNames": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 80,
                    "pattern": "^[a-z][a-z0-9_-]*$"
                  },
                  "additionalProperties": {
                    "type": "object",
                    "properties": {
                      "title": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 120
                      },
                      "description": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 300
                      },
                      "examples": {
                        "type": "array",
                        "items": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 300
                        },
                        "minItems": 1,
                        "maxItems": 3
                      }
                    },
                    "required": [
                      "title",
                      "description",
                      "examples"
                    ],
                    "additionalProperties": false
                  },
                  "maxProperties": 64
                }
              },
              "required": [
                "assistant"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "meta"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "en",
        "de",
        "pl"
      ],
      "additionalProperties": false
    },
    "bindings": {
      "type": "object",
      "properties": {
        "subjects": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "key": {
                "type": "string",
                "minLength": 1,
                "maxLength": 160
              },
              "kind": {
                "const": "timer"
              },
              "label": {
                "oneOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 120
                  },
                  {
                    "type": "object",
                    "properties": {
                      "en": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 120
                      },
                      "de": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 120
                      },
                      "pl": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 120
                      }
                    },
                    "required": [
                      "en"
                    ],
                    "additionalProperties": false
                  }
                ]
              },
              "roomKey": {
                "type": "string",
                "minLength": 1,
                "maxLength": 160
              },
              "fields": {
                "type": "object",
                "properties": {
                  "timer": {
                    "type": "object",
                    "properties": {
                      "entity": {
                        "type": "string",
                        "pattern": "^timer\\.[a-z0-9_]+$",
                        "maxLength": 240
                      },
                      "maxAgeSeconds": {
                        "type": "integer",
                        "minimum": 60,
                        "maximum": 86400
                      }
                    },
                    "required": [
                      "entity"
                    ],
                    "additionalProperties": false
                  }
                },
                "required": [
                  "timer"
                ],
                "additionalProperties": false
              },
              "indoor": {
                "type": "boolean"
              },
              "limits": {
                "type": "object",
                "maxProperties": 32,
                "propertyNames": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 80,
                  "pattern": "^[a-z][a-z0-9_-]*$"
                },
                "additionalProperties": {
                  "type": [
                    "string",
                    "number",
                    "boolean"
                  ],
                  "maxLength": 120
                }
              },
              "roomLabel": {
                "oneOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 120
                  },
                  {
                    "type": "object",
                    "properties": {
                      "en": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 120
                      },
                      "de": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 120
                      },
                      "pl": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 120
                      }
                    },
                    "required": [
                      "en"
                    ],
                    "additionalProperties": false
                  }
                ]
              }
            },
            "required": [
              "key",
              "kind",
              "label",
              "fields"
            ],
            "additionalProperties": false
          },
          "minItems": 0,
          "maxItems": 256
        },
        "policies": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "owner": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              },
              "metric": {
                "enum": [
                  "score",
                  "co2",
                  "pm2_5",
                  "voc",
                  "nox"
                ]
              },
              "entity": {
                "type": "string",
                "minLength": 1,
                "maxLength": 255,
                "pattern": "^[a-z_]+\\.[a-z0-9_]+$"
              },
              "unit": {
                "type": "string",
                "minLength": 1,
                "maxLength": 32
              },
              "levels": {
                "type": "array",
                "items": {
                  "type": "number"
                },
                "minItems": 2,
                "maxItems": 2
              },
              "higher_is_better": {
                "type": "boolean"
              },
              "helpers": {
                "type": "object",
                "maxProperties": 2,
                "additionalProperties": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 255,
                  "pattern": "^[a-z_]+\\.[a-z0-9_]+$"
                },
                "propertyNames": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 80,
                  "pattern": "^[a-z][a-z0-9_-]*$"
                }
              }
            },
            "required": [
              "owner",
              "metric",
              "entity",
              "unit",
              "levels",
              "higher_is_better"
            ],
            "additionalProperties": false
          },
          "minItems": 0,
          "maxItems": 0
        }
      },
      "required": [
        "subjects",
        "policies"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema",
    "component",
    "definitions",
    "translations",
    "bindings"
  ],
  "additionalProperties": false
}
