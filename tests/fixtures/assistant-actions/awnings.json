  "translations": {
    "en": {
      "meta": {
        "assistant": {
          "extend": {
            "description": "Request extension only with explicit access and fresh, safe wind evidence; existing protection still applies.",
            "examples": [
              "Extend the terrace awning"
            ],
            "title": "Extend the awning"
          },
          "retract": {
            "description": "Request retraction with explicit access, without a safe-wind assertion.",
            "examples": [
              "Retract the terrace awning"
            ],
            "title": "Retract the awning"
          },
          "stop": {
            "description": "Request STOP with explicit access when the integration supports it; position may be estimated.",
            "examples": [
              "Stop the terrace awning"
            ],
            "title": "Stop the awning"
          }
        }
      }
    },
    "de": {
      "meta": {
        "assistant": {
          "extend": {
            "description": "Fordert das Ausfahren nur mit Freigabe und einer aktuellen unbedenklichen Windmeldung an; der bestehende Schutz bleibt wirksam.",
            "examples": [
              "Fahre die Markise aus"
            ],
            "title": "Markise ausfahren"
          },
          "retract": {
            "description": "Fordert das Einfahren mit Freigabe an, ohne eine unbedenkliche Windmeldung vorauszusetzen.",
            "examples": [
              "Fahre die Markise ein"
            ],
            "title": "Markise einfahren"
          },
          "stop": {
            "description": "Fordert bei unterstützter STOP-Funktion und mit Freigabe das Anhalten an; die Position kann geschätzt sein.",
            "examples": [
              "Halte die Markise an"
            ],
            "title": "Markise anhalten"
          }
        }
      }
    },
    "pl": {
      "meta": {
        "assistant": {
          "extend": {
            "description": "Wysunięcie wymaga uprawnienia i aktualnego potwierdzenia braku alarmu wiatru; dotychczasowe zabezpieczenia nadal działają.",
            "examples": [
              "Wysuń markizę na tarasie"
            ],
            "title": "Wysuń markizę"
          },
          "retract": {
            "description": "Zwinięcie wymaga uprawnienia, ale nie wymaga potwierdzenia braku alarmu wiatru.",
            "examples": [
              "Zwiń markizę na tarasie"
            ],
            "title": "Zwiń markizę"
          },
          "stop": {
            "description": "Zatrzymanie wymaga uprawnienia i obsługi STOP przez integrację; pozycja może być szacowana.",
            "examples": [
              "Zatrzymaj markizę na tarasie"
            ],
            "title": "Zatrzymaj markizę"
          }
        }
      }
    }
